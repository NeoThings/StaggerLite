<launch>
  <param name="/use_sim_time" value="true" />
  <arg name="scan_topic"      value="/cx/scan"/>
  <arg name="imu_topic"      value="/dev/imu/raw/dist"/>
  <arg name="odom_topic"      value="/odom_combined"/>

  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_footprint_broadcaster"
        args="0 0 0 0 0 0 base_footprint base_link" /> -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_imu_broadcaster"
        args="0.13 0 0 0 0 0 base_link gyro_link" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_lidar_broadcaster"
      args="0.255 0 0 0 0 0 base_link laser_scanner_link" />

  <node pkg="rosbag" type="play" name="bag_play" output="screen"
        args="
            --pause
            --clock
            --start=0
            /home/neo/slam_data/bags/qtech.bag
            -r 1.0"/>

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(find neobot_mapping)/config
          -configuration_basename 2d_imu_odom.lua"
      output="screen">
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="imu" to="$(arg imu_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

  <node name="rviz" pkg="rviz" type="rviz" required="true"
      args="-d $(find neobot_mapping)/rviz/mapping.rviz" />

</launch>